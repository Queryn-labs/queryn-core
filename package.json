{
  "name": "osnova-core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "build": "npm run clean && tsc -p packages/types/tsconfig.json && tsc -p packages/manifest/tsconfig.json && tsc -p packages/validation/tsconfig.json && tsc -p packages/project/tsconfig.json",
    "clean": "node -e \"for (const p of ['types','manifest','validation','project']) require('node:fs').rmSync('packages/'+p+'/dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "pretest": "node ../osnova-spec/scripts/generate-contracts.mjs --check && node ../osnova-spec/scripts/check-comment-hygiene.mjs --check --repo osnova-core"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
